// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  instructor
  admin
  org_admin
}

enum UserTier {
  free
  pro
  institution
}

enum LessonProgress {
  not_started
  started
  completed
}

enum CheckpointState {
  not_started
  in_progress
  passed
  failed
}

enum CheckpointKind {
  checklist
  quiz
}

model User {
  id               String              @id @default(uuid())
  email            String              @unique
  /// Chosen by the learner on their first sign-in; falls back to the email
  /// local part in the UI until it is set.
  displayName      String?
  /// Learners can only sign in once they prove they own the mailbox. Rows that
  /// predate this column were backfilled to true by the migration.
  emailVerified    Boolean             @default(false)
  googleId         String?             @unique
  passwordHash     String?
  role             UserRole            @default(student)
  tier             UserTier            @default(free)
  usageMonth       String              @default("1970-01")
  usageSims        Int                 @default(0)
  avatarPreset     Int                 @default(0)
  stripeCustomerId String?             @unique
  createdAt        DateTime            @default(now())
  conversations   Conversation[]
  progress        UserProgress[]
  checkpointAttempts LessonCheckpointAttempt[]
  subscriptionEvents SubscriptionEvent[]
  refreshTokens   RefreshToken[]
  circuits        Circuit[]           @relation("UserCircuits")
  organizations   OrganizationMember[]
  webauthnCredentials WebAuthnCredential[]
  profileImage    ProfileImage?

  @@map("users")
}

/// The learner's uploaded (and already cropped client-side) profile photo.
/// Kept in its own table so every user query stays light; served as a plain
/// image response so <img> tags can render it without an auth header.
model ProfileImage {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profile_images")
}

/// Passkey (WebAuthn) credentials used for face / fingerprint sign-in. The
/// credential id is the discoverable lookup key so sign-in needs no email.
model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String[]  @default([])
  deviceType   String?
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("webauthn_credentials")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  members   OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           UserRole     @default(student)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model CourseModule {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  mdxContent  String
  // Keep embeddings portable for local Postgres installations. A future
  // pgvector migration can change this to a native vector column when vector
  // search is actually enabled; the current tutor falls back to text search.
  embedding   Json?
  embedded    Boolean        @default(false)
  order       Int?
  createdAt   DateTime       @default(now())
  progress    UserProgress[]
  checkpoints LessonCheckpoint[]

  @@map("course_modules")
}

model UserProgress {
  userId            String
  moduleId          String
  status            LessonProgress  @default(not_started)
  lastStep          Int             @default(0)
  mastery           Int             @default(0)
  xp                Int             @default(0)
  checkpointState   CheckpointState  @default(not_started)
  checkpointScore   Int?
  checkpointAttempts Int            @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  module            CourseModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
  @@map("user_progress")
}

model LessonCheckpoint {
  id          String                    @id @default(uuid())
  moduleId    String
  kind        CheckpointKind            @default(checklist)
  title       String
  prompt      String
  questions   Json
  maxScore    Int                       @default(100)
  source      String                    @default("course_module")
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  module      CourseModule              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attempts    LessonCheckpointAttempt[]

  @@unique([moduleId, source])
  @@index([moduleId])
  @@map("lesson_checkpoints")
}

model LessonCheckpointAttempt {
  id           String           @id @default(uuid())
  userId       String
  checkpointId String
  answers      Json
  score        Int
  maxScore     Int
  passed       Boolean
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpoint   LessonCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([userId, checkpointId])
  @@map("lesson_checkpoint_attempts")
}

model Conversation {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Json     @default("[]")
  circuitId  String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@map("conversations")
}

model SubscriptionEvent {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeEventId  String   @unique
  type           String
  payload        Json
  createdAt      DateTime @default(now())

  @@map("subscription_events")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Circuit {
  id         String   @id @default(uuid())
  ownerId    String
  owner      User     @relation("UserCircuits", fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  qubits     Int
  timesteps  Int
  operations Json
  createdAt  DateTime @default(now())

  @@index([ownerId])
  @@map("circuits")
}
